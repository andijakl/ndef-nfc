<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>NdefLibraryUwp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NdefLibraryExtension</PackageId>
    <Product>NFC / NDEF Library Platform Extensions</Product>
    <Title>NFC / NDEF Library Platform Extensions</Title>
    <Description>Extension library to the NFC / NDEF library to enable additional, platform-specific use cases.

Based on the cross platform NFC / NDEF library, this extension module adds NDEF record classes that integrate with Windows platform features: create vCard records from Windows Contacts, iCalendar records from Windows Appointments and Mime/Image records from WinUI 3 bitmaps. This extension includes 3rd party extension libraries.</Description>
    <PackageTags>nfc ndef proximity smart poster snep near field communication message record vcard vcf icalendar ical ics winui windows</PackageTags>
    <!-- The bundled VcardLibrary is LGPL-2.1 -->
    <PackageLicenseExpression>(LGPL-3.0-only OR GPL-3.0-only) AND LGPL-2.1-only</PackageLicenseExpression>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeVcardLibraryInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Ndef\NdefExceptionMessagesUwp.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>NdefExceptionMessagesUwp.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Ndef\NdefExceptionMessagesUwp.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>NdefExceptionMessagesUwp.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NdefLibrary\NdefLibrary.csproj" />
    <!-- Not published as its own package: VcardLibrary.dll is shipped inside this package -->
    <ProjectReference Include="..\VcardLibrary\VcardLibrary.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="IncludeVcardLibraryInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' And '%(ReferenceCopyLocalPaths.Filename)' == 'VcardLibrary'" />
    </ItemGroup>
  </Target>

</Project>
