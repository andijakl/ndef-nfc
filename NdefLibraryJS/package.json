{
  "name": "ndef-library",
  "version": "3.0.0",
  "description": "Parse and create standardized NDEF records for NFC tags, with Web NFC integration",
  "keywords": [
    "nfc",
    "ndef",
    "web-nfc",
    "nfc-tag",
    "smart-poster"
  ],
  "homepage": "https://andijakl.github.io/ndef-nfc/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andijakl/ndef-nfc.git",
    "directory": "NdefLibraryJS"
  },
  "license": "LGPL-3.0-or-later",
  "author": "Sebastian Höbarth / Andreas Jakl",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "dist",
    "types"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:bundle",
    "build:types": "tsc -p tsconfig.json",
    "build:bundle": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "rollup": "^4.64.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
